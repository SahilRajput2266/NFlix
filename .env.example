# Server Port
PORT=4000

# TMDB API Credentials (Get from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_ACCESS_TOKEN=your_tmdb_access_token_here

# Optional: Real-Debrid API Key for High-Speed Direct CDN Streaming
REALDEBRID_API_KEY=

# Render Keep-Alive (Prevents free tier instance from sleeping every 15 mins)
SERVER_URL=https://your-service-name.onrender.com
